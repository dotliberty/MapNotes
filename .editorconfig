root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.md]
trim_trailing_whitespace = false

[*.java]
# google-java-format 1.24.0, AOSP: 4-space indentation, 100 columns.
max_line_length = 100

[*.py]
# Black 26.10.1.
max_line_length = 88
